# ==========================================
# AI.Prof — Environment Configuration
# ==========================================

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Database Configuration (PostgreSQL + pgvector)
# Example local: postgresql+psycopg://postgres:postgres@localhost:5432/aiprof
# Example cloud: postgresql+psycopg://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aiprof

# JWT Security
JWT_SECRET=super-secret-key-please-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_SIMILARITY_THRESHOLD=0.65

# Storage Configuration ('local' or 's3')
# In production, use S3-compatible storage (e.g. Supabase Storage / AWS S3)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=uploads
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
